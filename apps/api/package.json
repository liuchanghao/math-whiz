{
  "name": "@math-whiz/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && next build",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:generate": "prisma generate",
    "db:hash-member-password": "tsx scripts/hash-member-password.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed-e2e": "tsx scripts/seed-e2e-admin.ts",
    "dev": "next dev --port 3001",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "start": "next start --port 3001",
    "test": "vitest run",
    "test:integration": "vitest run src/modules/identity/admin-auth/admin-auth.integration.test.ts && vitest run src/modules/identity/member-auth/member-auth.integration.test.ts && vitest run src/modules/catalog/catalog.integration.test.ts && vitest run src/modules/rewards/rewards.integration.test.ts",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@math-whiz/contracts": "workspace:*",
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "next": "16.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@math-whiz/typescript-config": "workspace:*",
    "@types/node": "22.19.21",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
